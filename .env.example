# ---------------------------------------------------------------------------
# UrbanPulse configuration. Copy to `.env` and adjust.
#
# Two backends are supported:
#   URBANPULSE_BACKEND=sqlite     -> SQLite + in-process queue (no Docker needed)
#   URBANPULSE_BACKEND=timescale  -> TimescaleDB + Kafka (docker compose stack)
# ---------------------------------------------------------------------------
URBANPULSE_BACKEND=sqlite

# --- sqlite backend ---
URBANPULSE_SQLITE_PATH=data/urbanpulse.sqlite

# --- timescale backend ---
URBANPULSE_PG_DSN=postgresql://urbanpulse:urbanpulse@timescaledb:5432/urbanpulse
URBANPULSE_KAFKA_BOOTSTRAP=kafka:9092
URBANPULSE_KAFKA_TOPIC=station_status
URBANPULSE_KAFKA_GROUP=urbanpulse-consumer

# --- cache ---
# Leave URBANPULSE_REDIS_URL empty to use the in-process cache (dev mode).
URBANPULSE_REDIS_URL=redis://redis:6379/0
URBANPULSE_CACHE_TTL_STATIONS=15
URBANPULSE_CACHE_TTL_HISTORY=60
URBANPULSE_CACHE_TTL_PREDICT=60
URBANPULSE_CACHE_TTL_REPLAY=300

# --- ingestion ---
URBANPULSE_GBFS_DISCOVERY=https://api.cyclocity.fr/contracts/ljubljana/gbfs/v3/gbfs.json
URBANPULSE_POLL_INTERVAL_S=60

# --- geography (Ljubljana city centre, used for the weather lookup) ---
URBANPULSE_LAT=46.05
URBANPULSE_LON=14.51

# --- model ---
URBANPULSE_MODEL_DIR=models

# --- websocket ---
URBANPULSE_WS_PUSH_INTERVAL_S=5

# --- frontend (Vite) ---
VITE_API_BASE=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
